FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

WORKDIR /src

COPY backend/ ./backend/

RUN dotnet restore \
    backend/src/AiWorkspace.McpServer/AiWorkspace.McpServer.csproj

RUN dotnet publish \
    backend/src/AiWorkspace.McpServer/AiWorkspace.McpServer.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime

WORKDIR /app

ENV ASPNETCORE_URLS=http://+:5083
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_RUNNING_IN_CONTAINER=true

RUN chown -R $APP_UID:$APP_UID /app

COPY --from=build --chown=$APP_UID:$APP_UID \
    /app/publish/ ./

USER $APP_UID

EXPOSE 5083

ENTRYPOINT ["dotnet", "AiWorkspace.McpServer.dll"]
